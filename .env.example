# Required: local OpenAI-compatible completion server.
# Supports localhost, explicit loopback/private/link-local IPs, and .local
# mDNS names whose complete system resolution is exclusively local.
# Empty, failed, public, or mixed public/local DNS results fail closed.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_HEALTH_URL=http://127.0.0.1:1234/v1/models
# For a local mDNS service, use the same verified .local hostname in both URLs:
# LOCAL_LLM_BASE_URL=http://jarvis-ai.local:8080/v1
# LOCAL_LLM_HEALTH_URL=http://jarvis-ai.local:8080/health
LOCAL_LLM_MODEL=your-local-model-name

# Required: BGE embedding server (llama-server --embedding) for memory recall.
# Same local-only URL rules as above; health is checked at the server root.
# If it is down, Jarvis still starts and recall falls back to keywords.
JARVIS_EMBEDDING_BASE_URL=http://jarvis-ai.local:8081/v1
JARVIS_EMBEDDING_MODEL=bge-small-en-v1.5

# Local archive and memory (one SQLite file). A relative path resolves from
# the checkout directory when Jarvis starts.
JARVIS_ARCHIVE_PATH=data/jarvis.sqlite3

# Speech is off unless the chosen engine's model is set. See scripts/tts/README.md
# for local speech setup. JARVIS_TTS_ENGINE is supertonic (the default when
# unset) or piper; any other value disables speech with a warning.
#
# Supertonic (default engine): omit JARVIS_TTS_MODEL_DIR to keep speech disabled.
# JARVIS_TTS_ENGINE=supertonic
# JARVIS_TTS_MODEL_DIR=/home/pi/.local/share/jarvis/tts/models/supertonic-3-int8-m5
#
# Piper: the .onnx voice file (its .onnx.json config sits beside it). Jarvis expects
# the worker to report the file name without .onnx as its voice, and the worker
# resolves symlinks first, so point at the real file, not a differently named link.
# JARVIS_TTS_ENGINE=piper
# JARVIS_TTS_PIPER_MODEL=/home/pi/.local/share/jarvis/piper/voices/en_GB-northern_english_male-medium.onnx
#
# Both engines need an absolute interpreter. JARVIS_TTS_WORKER defaults to the
# engine's script under scripts/tts/. JARVIS_TTS_THREADS is 1-4 (default 2).
# JARVIS_TTS_PYTHON=/home/pi/.local/share/jarvis/tts/venv/bin/python
# JARVIS_TTS_WORKER=scripts/tts/piper_worker.py
# JARVIS_TTS_THREADS=2
# JARVIS_AUDIO_DEVICE=alsa:...
