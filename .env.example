# Required: local OpenAI-compatible completion server.
# Supports localhost, explicit loopback/private/link-local IPs, and .local
# mDNS names whose complete system resolution is exclusively local.
# Empty, failed, public, or mixed public/local DNS results fail closed.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_HEALTH_URL=http://127.0.0.1:1234/v1/models
# For a local mDNS service, use the same verified .local hostname in both URLs:
# LOCAL_LLM_BASE_URL=http://jarvis-ai.local:8080/v1
# LOCAL_LLM_HEALTH_URL=http://jarvis-ai.local:8080/health
LOCAL_LLM_MODEL=your-local-model-name

# Local archive and memory projection. Relative paths resolve from the checkout
# directory when Jarvis starts. The embedding files and ONNX Runtime are setup
# assets; Jarvis never downloads them during chat.
JARVIS_ARCHIVE_PATH=data/jarvis.sqlite3
JARVIS_EMBEDDING_MODEL_DIR=data/embeddings
JARVIS_MEMORY_INDEX_DIR=data/memory-index
# Set this to the absolute ONNX Runtime library path printed by
# scripts/embeddings/setup.sh when provisioning the embedding model.
# ORT_DYLIB_PATH=/absolute/path/to/libonnxruntime.so

# Omit JARVIS_TTS_MODEL_DIR to keep speech disabled. See scripts/tts/README.md
# for local speech setup and optional TTS environment variables.
